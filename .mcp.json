{
  "mcpServers": {
    "desk-weak-reader": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "dclabagent",
        "serve",
        "weak"
      ],
      "env": {
        "DESK_KEY": "reader",
        "PYTHONPATH": "src"
      }
    },
